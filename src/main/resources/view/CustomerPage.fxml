<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="432.0" prefWidth="600.0" style="-fx-background-color: #232F72;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.icet.ecom.controller.CustomerController">
   <children>
      <Label layoutX="211.0" layoutY="14.0" text="User Records">
         <font>
            <Font name="System Bold" size="29.0" />
         </font>
         <textFill>
            <LinearGradient endX="1.0" endY="1.0">
               <stops>
                  <Stop>
                     <color>
                        <Color red="0.07145468145608902" green="0.42207297682762146" blue="0.45394736528396606" />
                     </color>
                  </Stop>
                  <Stop offset="1.0">
                     <color>
                        <Color red="1.0" green="1.0" blue="1.0" />
                     </color>
                  </Stop>
               </stops>
            </LinearGradient>
         </textFill>
      </Label>
      <TextField fx:id="txtId" layoutX="84.0" layoutY="69.0" promptText="UserId" />
      <TextField fx:id="txtName" layoutX="353.0" layoutY="69.0" promptText="Name" />
      <TextField fx:id="txtEmail" layoutX="84.0" layoutY="114.0" promptText="Email" />
      <TextField fx:id="txtPhoneNumber" layoutX="353.0" layoutY="114.0" promptText="PhoneNumber" />
      <Button fx:id="btnCreate" layoutX="42.0" layoutY="150.0" mnemonicParsing="false" onAction="#btnCreateOnAction" prefHeight="25.0" prefWidth="84.0" text="Create">
         <font>
            <Font name="System Bold" size="13.0" />
         </font></Button>
      <Button fx:id="btnReset" layoutX="330.0" layoutY="150.0" mnemonicParsing="false" onAction="#btnResetOnAction" prefHeight="25.0" prefWidth="84.0" text="Reset">
         <font>
            <Font name="System Bold" size="13.0" />
         </font></Button>
      <Button fx:id="btnUpdate" layoutX="191.0" layoutY="150.0" mnemonicParsing="false" onAction="#btnUpdateOnAction" prefHeight="25.0" prefWidth="84.0" text="Update">
         <font>
            <Font name="System Bold" size="14.0" />
         </font></Button>
      <Button fx:id="btnDelete" layoutX="460.0" layoutY="150.0" mnemonicParsing="false" onAction="#btnDeleteOnAction" prefHeight="25.0" prefWidth="84.0" text="Delete">
         <font>
            <Font name="System Bold" size="13.0" />
         </font></Button>
      <TableView fx:id="tblUserTable" layoutX="9.0" layoutY="183.0" prefHeight="200.0" prefWidth="582.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="97.5" text="UserId" />
          <TableColumn fx:id="colName" prefWidth="134.5" text="Name" />
            <TableColumn fx:id="colEmail" prefWidth="216.5" text="Email" />
            <TableColumn fx:id="colPhoneNumber" prefWidth="134.5" text="Phone Number" />
        </columns>
      </TableView>
      <Button fx:id="btnNext" layoutX="460.0" layoutY="393.0" mnemonicParsing="false" onAction="#btnNextOnAction" prefWidth="68.0" text="Next">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
