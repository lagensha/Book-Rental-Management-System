<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.paint.RadialGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #202940;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.icet.ecom.controller.BookController">
   <children>
      <Label layoutX="169.0" text="Books Report">
         <font>
            <Font name="System Bold" size="35.0" />
         </font>
         <textFill>
            <RadialGradient centerX="0.5" centerY="0.5" radius="0.5">
               <stops>
                  <Stop>
                     <color>
                        <Color red="0.3974171578884125" green="0.7368420958518982" blue="0.7368420958518982" />
                     </color>
                  </Stop>
                  <Stop offset="1.0">
                     <color>
                        <Color red="0.7708790302276611" green="0.9276315569877625" blue="0.9276315569877625" />
                     </color>
                  </Stop>
               </stops>
            </RadialGradient>
         </textFill>
      </Label>
      <TextField fx:id="txtTitle" layoutX="63.0" layoutY="64.0" promptText="Title" />
      <TextField fx:id="txtAuthor" layoutX="327.0" layoutY="64.0" promptText="Author" />
      <TextField fx:id="txtCategory" layoutX="63.0" layoutY="109.0" prefHeight="25.0" prefWidth="163.0" promptText="Category" />
      <TextField fx:id="txtQuantityDetails" layoutX="336.0" layoutY="115.0" promptText="Quantity Details" />
      <TableView fx:id="tblBooks" layoutX="54.0" layoutY="200.0" prefHeight="200.0" prefWidth="492.0">
        <columns>
          <TableColumn fx:id="colTitle" prefWidth="122.0" text="Title" />
            <TableColumn fx:id="colAuthor" prefWidth="122.0" text="Author" />
            <TableColumn fx:id="colCategory" prefWidth="122.0" text="Category" />
            <TableColumn fx:id="colQuantity" prefWidth="122.0" text="Quantity Details" />
        </columns>
      </TableView>
      <Button fx:id="btnCreate" layoutX="72.0" layoutY="149.0" mnemonicParsing="false" onAction="#btnCreateOnAction" prefHeight="33.0" prefWidth="73.0" text="Create">
         <font>
            <Font name="System Bold" size="15.0" />
         </font>
      </Button>
      <Button fx:id="btnUpdate" layoutX="190.0" layoutY="149.0" mnemonicParsing="false" onAction="#btnUpdateOnAction" prefHeight="33.0" prefWidth="73.0" text="Update">
         <font>
            <Font name="System Bold" size="15.0" />
         </font>
      </Button>
      <Button fx:id="btnReset" layoutX="327.0" layoutY="149.0" mnemonicParsing="false" onAction="#btnResetOnAction" prefHeight="33.0" prefWidth="73.0" text="Reset">
         <font>
            <Font name="System Bold" size="15.0" />
         </font>
      </Button>
      <Button fx:id="btnDelete" layoutX="466.0" layoutY="149.0" mnemonicParsing="false" onAction="#btnDeleteOnAction" prefHeight="33.0" prefWidth="73.0" text="Delete">
         <font>
            <Font name="System Bold" size="15.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
