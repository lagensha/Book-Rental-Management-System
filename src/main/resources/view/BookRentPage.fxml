<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.paint.RadialGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="lblNetTotal" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #111844;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.icet.ecom.controller.BookRentController">
   <children>
      <Label layoutX="192.0" layoutY="8.0" text="Rent Books ">
         <font>
            <Font name="System Bold" size="30.0" />
         </font>
         <textFill>
            <RadialGradient centerX="0.7479338842975207" centerY="0.5" radius="0.5">
               <stops>
                  <Stop>
                     <color>
                        <Color red="0.5600024461746216" green="0.7496141791343689" blue="0.7631579041481018" />
                     </color>
                  </Stop>
                  <Stop offset="1.0">
                     <color>
                        <Color red="1.0" green="1.0" blue="1.0" />
                     </color>
                  </Stop>
               </stops>
            </RadialGradient>
         </textFill>
      </Label>
      <ComboBox fx:id="cmbBookId" layoutX="23.0" layoutY="72.0" onAction="#cmdBookIdOnAction" prefWidth="150.0" promptText="Books Id" />
      <ComboBox fx:id="cmbCustomerId" layoutX="225.0" layoutY="72.0" onAction="#cmbCustomerIdOnAction" prefWidth="150.0" promptText="Customer Id" />
      <TextField fx:id="txtQuantity" layoutX="417.0" layoutY="72.0" promptText="Quantity" />
      <Button fx:id="btnAddToCart" layoutX="122.0" layoutY="130.0" mnemonicParsing="false" onAction="#btnAddToCartOnAction" prefHeight="25.0" prefWidth="70.0" text="Add">
         <font>
            <Font name="System Bold" size="15.0" />
         </font>
      </Button>
      <TableView fx:id="tblBooksOrder" layoutX="96.0" layoutY="174.0" prefHeight="200.0" prefWidth="392.0">
        <columns>
          <TableColumn fx:id="colBookId" prefWidth="112.0" text="Book Id" />
            <TableColumn fx:id="colCustomerId" prefWidth="132.0" text="Customer Id" />
            <TableColumn fx:id="colQuantity" prefWidth="144.5" text="Quantity" />
        </columns>
      </TableView>
      <Button fx:id="btnPlaceOrder" layoutX="292.0" layoutY="130.0" mnemonicParsing="false" onAction="#btnPlaceOrderOnAction" prefHeight="31.0" prefWidth="105.0" text="Get Book">
         <font>
            <Font name="System Bold" size="15.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
